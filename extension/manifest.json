{
  "manifest_version": 3,
  "name": "Java 選取執行器",
  "version": "0.1.0",
  "description": "選取網頁上的 Java 程式碼，在小型浮窗中查看本機沙箱的執行結果。",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:43123/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Java 選取執行器", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
