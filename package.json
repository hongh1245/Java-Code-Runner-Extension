{
  "name": "java-selection-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run selected Java code in an isolated local sandbox from Chrome.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "sandbox:build": "docker build -t java-selection-runner:local -f sandbox/Dockerfile sandbox",
    "test": "node --test test/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.mjs",
    "test:browser": "playwright test --project=extension",
    "test:ui": "playwright test --project=ui"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
